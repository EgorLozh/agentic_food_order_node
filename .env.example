# --- Telegram ---
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# --- LLM (порт агента из Python-версии) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- БД каркаса (FeedMer) ---
# Заказ пишется кодом каркаса, поэтому те же переменные, что у FeedMer.
DB_URL=postgresql://user:pass@localhost:5432/testing
DB_LOGS_URL=postgresql://user:pass@localhost:5432/testing
# TESTING=1 отключает ssl (как в локальном FeedMer)
TESTING=1

# --- Код каркаса как библиотека ---
# Путь до чекаута FeedMer (файл DBlib.js). FeedMer не меняется: только require.
FEEDMER_LIB_DIR=../FeedMer
# FEEDMER_DB_FILE=../FeedMer/DBlib.js

# --- Правила заказа бескаркасного бота ---
ORDER_SOURCE_TAG=agentic
ORDERS_DEFAULT_CAFE_ID=
