# ================= Telegram =================
BOT_TOKEN=
# Куда слать заказы (нужен только при ORDER_NOTIFY_ADMIN=1)
ADMIN_TELEGRAM_ID=
# 1 — после отправки заказа в БД дополнительно уведомлять админа в Telegram
ORDER_NOTIFY_ADMIN=0

# ================= LLM =================
# openai | deepseek | ollama
LLM_PROVIDER=deepseek
# --- deepseek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# --- openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# --- ollama (локально) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:26b
OLLAMA_API_KEY=ollama
# Таймаут одного запроса к модели, сек
LLM_TIMEOUT_SECONDS=120
# Потолок токенов ответа (пусто — не задавать)
# LLM_MAX_TOKENS=
# Максимальное время одного хода пользователя (все раунды tools), сек
AGENT_TURN_TIMEOUT_SECONDS=90
# Сколько последних реплик диалога держать в контексте агента (0 — без истории)
DIALOG_HISTORY_LIMIT=6

# ================= БД каркаса (FeedMer) =================
# Заказ пишет код каркаса, поэтому переменные те же, что у FeedMer.
DB_URL=postgresql://user:pass@localhost:5432/testing
DB_LOGS_URL=postgresql://user:pass@localhost:5432/testing
# TESTING=1 отключает ssl (как в локальном FeedMer)
TESTING=1

# ================= Код каркаса как библиотека =================
# Путь до чекаута FeedMer (файл DBlib.js). FeedMer не меняется: только require.
FEEDMER_LIB_DIR=../FeedMer
# FEEDMER_DB_FILE=../FeedMer/Dblib.js

# ================= Правила заказа бота =================
# Метка источника в orders.comment-подобных полях и логах
ORDER_SOURCE_TAG=agentic
# Кафе по умолчанию, если точка самовывоза не выбрана
ORDERS_DEFAULT_CAFE_ID=
